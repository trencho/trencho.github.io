{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://trencho.github.io/",
  "type": "module",
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks || true",
    "predeploy": "yarn build",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "build": "tsc -noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@emailjs/browser": "5.0.3",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-google-recaptcha": "3.1.0",
    "react-icons": "5.7.0",
    "react-router": "8.5.1",
    "react-toastify": "11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-google-recaptcha": "2.1.9",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "gh-pages": "6.3.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "sass-embedded": "1.107.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "resolutions": {
    "js-yaml": "4.3.2"
  }
}
